NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional locally. On Vercel the app can use VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Required for Admin > Nutzer anlegen / Einladung senden.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. Emails (new need → KW, player suggestion → club, interest → KW, monthly reminder).
# Without RESEND_API_KEY nothing is sent; the app only logs. Domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="KW Sports <noreply@kwsports.de>"
# Optional: where replies go, and who at KW gets notified (comma-separated). Default: all admin users.
EMAIL_REPLY_TO=
KW_NOTIFY_EMAILS=
# Vercel Cron sends this as a Bearer token to /api/cron/need-reminders (monthly, 1st at 07:17 UTC).
CRON_SECRET=
